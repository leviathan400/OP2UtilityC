#include <windows.h>

// Windows version-info resource embedded into op2utility.dll.
// Shows up under the file's Properties -> Details tab.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "Outpost Universe"
            VALUE "FileDescription",  "OP2Utility"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "op2utility"
            VALUE "LegalCopyright",   "Outpost Universe"
            VALUE "OriginalFilename", "OP2Utility.dll"
            VALUE "ProductName",      "OP2Utility"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
